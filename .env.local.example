# Database
POSTGRES_PRISMA_URL=your_postgres_connection_string_here

# Authentication
APP_PASSKEY=your_default_passkey_here

# Password Hashing (Required for multi-user support)
# Generate a random secret: openssl rand -hex 32
# This acts as a "pepper" for additional password security
PASSKEY_HASH_SECRET=your_secret_random_string_here
