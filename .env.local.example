# Supabase Database URL (Prisma with connection pooling)
# When using Vercel + Supabase integration, this is auto-injected as POSTGRES_PRISMA_URL
# Format: postgres://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
POSTGRES_PRISMA_URL="postgres://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Application Passkey (choose a secure passkey)
APP_PASSKEY="your-secure-passkey-here"
