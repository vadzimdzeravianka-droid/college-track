{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "npx eslint app actions lib components schemas --max-warnings 0 && npm run build && npm test",
            "statusMessage": "Running pre-commit checks (lint, build, test)...",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
