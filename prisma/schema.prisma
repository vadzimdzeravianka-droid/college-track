datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  REACH
  MATCH
  SAFETY
}

enum Status {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  WAITLISTED
  ACCEPTED
  DECLINED
}

enum Strategy {
  ED    // Early Decision
  EA    // Early Action
  RD    // Regular Decision
}

model College {
  id              String    @id @default(uuid())
  name            String
  category        Category
  status          Status    @default(NOT_STARTED)
  strategy        Strategy
  deadlineApp     DateTime? @map("deadline_app")
  deadlineFinaid  DateTime? @map("deadline_finaid")
  location        String?
  major           String?
  portalUrl       String?   @map("portal_url")
  portalUser      String?   @map("portal_user")
  portalPassword  String?   @map("portal_password")
  notes           String?   @db.Text
  costTuition     Decimal?  @map("cost_tuition") @db.Decimal(10, 2)
  costRoomBoard   Decimal?  @map("cost_room_board") @db.Decimal(10, 2)
  costFees        Decimal?  @map("cost_fees") @db.Decimal(10, 2)
  costBooks       Decimal?  @map("cost_books") @db.Decimal(10, 2)
  costPersonal    Decimal?  @map("cost_personal") @db.Decimal(10, 2)
  costOther       Decimal?  @map("cost_other") @db.Decimal(10, 2)
  isInState       Boolean?  @map("is_in_state")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  checklist       Checklist?

  @@map("colleges")
}

model Checklist {
  id                          String  @id @default(uuid())
  collegeId                   String  @unique @map("college_id")
  lorTeacher                  Boolean @default(false) @map("lor_teacher")
  transcriptSent              Boolean @default(false) @map("transcript_sent")
  testScoresSent              Boolean @default(false) @map("test_scores_sent")
  essayCount                  Int     @default(0) @map("essay_count")
  mainEssayComplete           Boolean @default(false) @map("main_essay_complete")
  supplementalEssaysCompleted Int     @default(0) @map("supplemental_essays_completed")
  finaidGreenLight            Boolean @default(false) @map("finaid_green_light")

  college                     College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@map("checklists")
}
